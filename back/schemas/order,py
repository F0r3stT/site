from pydantic import BaseModel, Field
from typing import Optional, List
from datetime import datetime
from app.models.order import OrderStatus, PCBColor


class OrderBase(BaseModel):
    title: str
    description: Optional[str] = None
    pcb_quantity: int = Field(..., ge=1)
    pcb_width: float = Field(..., ge=1)
    pcb_height: float = Field(..., ge=1)
    layer_count: int = Field(..., ge=1, le=32)
    material: Optional[str] = None
    smt_required: bool = False
    pcb_color: PCBColor = PCBColor.GREEN
    pcb_thickness: float = 1.6
    urgent: bool = False


class OrderCreate(OrderBase):
    pass


class OrderUpdate(BaseModel):
    title: Optional[str] = None
    description: Optional[str] = None
    status: Optional[OrderStatus] = None


class OrderInDB(OrderBase):
    id: str
    customer_id: str
    status: OrderStatus
    base_price: Optional[float] = None
    final_price: Optional[float] = None
    created_at: datetime
    updated_at: datetime

    class Config:
        from_attributes = True


class OrderResponse(OrderInDB):
    pass


class PCBPriceRequest(BaseModel):
    width: float
    height: float
    quantity: int
    layers: int
    color: PCBColor
    urgent: bool = False


class PCBPriceResponse(BaseModel):
    base_price: float
    engineering_fee: float
    material_cost: float
    layer_multiplier: float
    color_fee: float
    urgent_multiplier: float
    total: float
    total_amd: int  # Округлено до 100 драм